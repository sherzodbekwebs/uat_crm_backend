
# ==================================
# APPLICATION
# ==================================

NODE_ENV=production

# cPanel tomonidan PORT berilsa, u ustuvor bo'ladi.
PORT=3001

# ==================================
# POSTGRESQL DATABASE
# ==================================

# Hostingdagi haqiqiy DB qiymatlarini kiriting.
# Parolda @, #, :, / kabi belgilar bo'lsa,
# URL-encode qilish talab etiladi.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# true faqat DB provayderi TLS talab qilsa
# va database.ts to'g'ri sozlangan bo'lsa.
DB_SSL=false

# ==================================
# JWT AUTHENTICATION
# ==================================

# Kamida 32 ta tasodifiy byte asosida
# yangi JWT_SECRET yarating.
JWT_SECRET=c149b57f38e4fc5c0bf3e7c537aa35ad1bea702dce594337b285781ac2d6cbc5b2160916ed8ab104e372c081493675ee

# ==================================
# INITIAL USER PASSWORDS
# ==================================

# Faqat foydalanuvchilarni yaratadigan
# SQL/seed skriptlaringiz ishlatsa kerak.
# Har bir foydalanuvchiga alohida parol.
LOGIN_PASSWORD=admin
ADMIN_PASSWORD=yGqziMjtfUuhItwR


# ==================================
# FRONTEND CORS
# ==================================

# Production frontend domenini yozing.
FRONTEND_ORIGIN=https://crm.uzautotrailer.uz

# ==================================
# EXTERNAL PRODUCTS API
# ==================================

PRODUCTS_API_URL=https://api.uzautotrailer.uz/products

# ==================================
# REVERSE PROXY
# ==================================

# Hosting konfiguratsiyasi aniqlanmaguncha 0
TRUST_PROXY_HOPS=0
